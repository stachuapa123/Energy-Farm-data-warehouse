# ---------- SQL Server ----------------------------------------------------------
# sa password: at least 8 characters with upper case, lower case and digits/symbols.
# Avoid characters that shells or .env parsers treat specially (# $ ! " ' ` and spaces).
MSSQL_SA_PASSWORD=EcoVolt_Strong_Pass_2025
MSSQL_PORT=1433
# Folder with the generator output (contains T1/, T2/, T2_delta/), relative to this folder.
DATA_DIR=./Data
# false = SQL Server is installed natively on this Linux machine (run_sql.sh then uses the local sqlcmd).
MSSQL_IN_DOCKER=true

# ---------- Cube -----------------------------------------------------------------
CUBEJS_DB_TYPE=mssql
# "mssql" = the container from docker-compose.yml; host.docker.internal = SQL Server on the host.
CUBEJS_DB_HOST=mssql
CUBEJS_DB_PORT=1433
# EcoVoltDW = without_partitions, EcoVoltDW_Part = with_partitions
CUBEJS_DB_NAME=EcoVoltDW
CUBEJS_DB_USER=sa
CUBEJS_DB_PASS=EcoVolt_Strong_Pass_2025
# Local SQL Server without a trusted certificate -> no TLS.
CUBEJS_DB_SSL=false
CUBEJS_DEV_MODE=true
CUBEJS_API_SECRET=ecovolt-dev-secret-change-me
CUBEJS_SCHEMA_PATH=model
# Tesseract planner: needed for multi_stage / time_shift measures (default since Cube 1.7).
CUBEJS_TESSERACT_SQL_PLANNER=true
CUBEJS_TELEMETRY=false
